{
  "name": "ai-agent-workspace-map",
  "private": true,
  "version": "0.1.0",
  "description": "RPG command center for orchestrating Claude Code sessions",
  "author": "Guillaume Argiles",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper node_modules/node-pty/prebuilds/darwin-x64/spawn-helper 2>/dev/null || true",
    "dev": "concurrently -n vite,server -c blue,magenta \"vite\" \"npm:server\"",
    "dev:vite": "vite",
    "dev:electron": "electron-vite dev",
    "server": "tsx watch server/start.ts",
    "build": "electron-vite build",
    "build:web": "tsc -b && vite build",
    "package": "electron-vite build && electron-builder",
    "package:dir": "electron-vite build && electron-builder --dir",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.3",
    "node-pty": "^1.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.7",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "phaser": "^3.86.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^4.1.7"
  }
}
